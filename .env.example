# ==============================================================================
# DREEM ROOM: Muhit o'zgaruvchilari (Environment Variables)
# ==============================================================================

# 1. Neon PostgreSQL Database URL (Neon.tech dan olingan havola)
DATABASE_URL=postgresql://user:password@endpoint.neon.tech/neondb?sslmode=require

# 2. Telegram Bot Sozlamalari (Bitta yagona bot: mijozlar va adminlar uchun)
BOT_TOKEN=
BOT_USERNAME=
OWNER_TELEGRAM_ID=

# 3. Maqsadli Telegram Kanal yoki Guruh ID (masalan: -1004367729128)
TARGET_CHAT_ID=

# 4. Veb-sayt / Mini App manzili (Vercel yoki Railway domeni)
WEB_APP_URL=https://dreemroom.vercel.app

# 5. Admin Panel Kirish ma'lumotlari
# (Eslatma: Agar ADMIN_PASSWORD bo'sh qoldirilsa, server birinchi marta xavfsiz tasodifiy parol yaratib konsolga chiqaradi)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
JWT_SECRET=

# 6. Server Port (Railway avtomatik belgilaydi)
PORT=3000
