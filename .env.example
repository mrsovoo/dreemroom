# ==============================================================================
# UNIVERSAL CLOTHING STORE: Muhit o'zgaruvchilari (.env.example)
# ==============================================================================
# Quyidagi namunani .env fayliga nusxalang va o'z qiymatlaringizni kiriting:
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MA'LUMOTLAR BAZASI (Database)
# ------------------------------------------------------------------------------
# Neon Serverless PostgreSQL ulanish manzili (https://neon.tech dan olinadi).
# Ixtiyoriy: Agar kiritilmasa, tizim lokal JSON fayllarda ishlaydi (development uchun).
# Ishlab chiqarish (production) muhitida MAJBURIY!
# Namuna: postgresql://user:password@ep-sample-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# ------------------------------------------------------------------------------
# 2. TELEGRAM BOT SOZLAMALARI
# ------------------------------------------------------------------------------
# @BotFather orqali olingan yagona Telegram bot tokeni.
# MAJBURIY (Bot xizmati ishlashi uchun).
# Namuna: 1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
BOT_TOKEN=

# Telegram botingizning foydalanuvchi nomi (@ belgisisiz).
# Ixtiyoriy (Kiritilmasa, bot Telegram API dan o'zi avtomatik aniqlaydi).
# Namuna: my_clothing_shop_bot
BOT_USERNAME=

# Do'kon egasining Telegram ID raqami (@userinfobot orqali bilish mumkin).
# Ushbu ID ga ega foydalanuvchi botda avtomatik to'liq Admin huquqiga ega bo'ladi.
# Tavsiya etiladi (Topiklarni sozlash va admin buyruqlari uchun).
# Namuna: 123456789
OWNER_TELEGRAM_ID=

# Telegram Forum Guruhi yoki Kanali ID raqami (-100 bilan boshlanadi).
# Yangi buyurtmalar va bildirishnomalar yuboriladigan guruh yoki kanal.
# Namuna: -1001234567890
TARGET_CHAT_ID=

# Telegram BotFather da yaratilgan Mini App (Web App) qisqa nomi (short name).
# Standart qiymat: app
TELEGRAM_APP_NAME=app

# ------------------------------------------------------------------------------
# 3. VEB-SAYT VA TELEGRAM MINI APP MANZILI
# ------------------------------------------------------------------------------
# Veb-vitrina va Telegram Mini App domen manzili (Vercel, Railway yoki o'z domeningiz).
# Namuna: https://your-brand-store.vercel.app yoki http://localhost:5173
WEB_APP_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 4. ADMIN PANEL XAVFSIZLIGI
# ------------------------------------------------------------------------------
# Admin panelga (/admin) kirish uchun login nomi.
# Standart: admin
ADMIN_USERNAME=admin

# Admin panel paroli.
# MUHIM: Bo'sh qoldirilsa, server birinchi ishga tushishda tasodifiy xavfsiz parol
# yaratib konsolga chiqaradi va .auth_credentials.json faylida saqlaydi.
# Namuna: kuchli_maxfiy_parol_2026!
ADMIN_PASSWORD=

# JWT sessiya va cookie tokenlarini imzolash uchun maxfiy kalit (kamida 32 belgi).
# Bo'sh qoldirilsa, server tasodifiy 64 belgili hex kalit yaratadi.
# Namuna: d83b6f2c8d20e7f415391295b9a7c36e4f1a2e5d7c9b0e1f3a5c7e9b1d3f5a7c
JWT_SECRET=

# ------------------------------------------------------------------------------
# 5. SERVER VA TIZIM SOZLAMALARI
# ------------------------------------------------------------------------------
# Server porti (Railway, Render kabi bulutli xizmatlar avtomatik belgilaydi).
# Standart: 3000
PORT=3000

# Demo ma'lumotlar rejimi (true yoki false).
# true bo'lsa, baza bo'sh bo'lganda 7 ta neytral demo mahsulot vitrinada ko'rinadi.
# Standart: false
DEMO_MODE=false
VITE_DEMO_MODE=false

# Kunlik hisobot va avtomatik vazifalar (Cron) uchun himoya kaliti.
# Ixtiyoriy: Vercel Cron yoki tashqi cron xizmatlari uchun.
CRON_SECRET=
