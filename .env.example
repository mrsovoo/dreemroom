# ==============================================================================
# DREEM ROOM: Muhit o'zgaruvchilari (Environment Variables)
# ==============================================================================

# 1. Neon PostgreSQL Database URL (Neon.tech dan olingan havola)
DATABASE_URL=postgresql://user:password@endpoint.neon.tech/neondb?sslmode=require

# 2. Admin Bot Sozlamalari (@dreemroom_adm_bot)
# Mahsulot yuklash, tahrirlash va kanalga e'lon joylash uchun bot
ADMIN_BOT_TOKEN=
ADMIN_BOT_USERNAME=dreemroom_adm_bot
ADMIN_SECRET=dreemroom-adm

# 3. Mijozlar uchun Buyurtma Boti (@dreemroom_bot)
# Kanal postlarida "Buyurtma berish" qilib ko'rsatiladigan va mijozlar do'konni ochadigan bot
ORDER_BOT_TOKEN=
ORDER_BOT_USERNAME=dreemroom_bot

# 4. Maqsadli Telegram Kanal yoki Guruh ID (masalan: -1004367729128)
TARGET_CHAT_ID=

# 5. Veb-sayt / Mini App manzili (Vercel yoki Railway domeni)
WEB_APP_URL=https://dreemroom.vercel.app

# 6. Admin Panel Kirish ma'lumotlari
ADMIN_USERNAME=admin
ADMIN_PASSWORD=dreem2025

# 7. Server Port (Railway avtomatik belgilaydi)
PORT=3000
